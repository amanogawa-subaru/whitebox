{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "padding": {
            "top": 3,
            "left": 1,
            "right": 5
        }
    },

    "modules": [
        "break",

        {
            "type": "custom",
            "format": "\u001b[90m── Hardware ──"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├ 󰻠 ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├ 󰍹 ",
            "hideType": "integrated",
            "format": "{1} {2}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "└ 󰑭 ",
            "keyColor": "green"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[90m── Software ──"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "├ 󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "├ 󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└ 󰞷 ",
            "keyColor": "yellow"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[90m── Desktop ──"
        },
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "├ 󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "└ 󰆍 ",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }

    ]
}
