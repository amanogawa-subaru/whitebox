{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
		"type": "kitty-direct",
		"source": "~/.config/fastfetch/logo.png",
		"width": 20,
		"height": 10,
		"padding": {
			"top": 1,
			"left": 1,
			"right": 3
		}
	},
    "modules": [
        {
            "type": "host",
            "key": " 󰌢 ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " 󰻠 ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": " 󰍹 ",
            "hideType": "integrated",
            "format": "{1} {2}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": " 󰑭 ",
            "keyColor": "green"
        },

        {
            "type": "os",
            "key": "  ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": " 󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": " 󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " 󰞷 ",
            "keyColor": "yellow"
        },

        {
            "type": "de",
            "key": "󰧨 ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": " 󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " 󰆍 ",
            "keyColor": "blue"
        },
        {
			"type": "custom",
			"key": " 󰋑 ",
			"keyColor": "magenta",
			"format": "Just Monika"
		},
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
        
        

    ]
}
